"use client";

import Link from "next/link";
import { usePathname } from "next/navigation";
import { AnimatePresence, motion, useMotionValueEvent, useScroll } from "framer-motion";
import { useEffect, useRef, useState } from "react";
import { nav, event, organiser } from "@/lib/site";
import { Logo } from "@/components/ui/Logo";
import { TicketButton } from "@/components/ui/TicketButton";
import { useLenis } from "@/components/animation/SmoothScroll";
import { cn } from "@/lib/cn";
import { Spark } from "@/components/illustrations/Glyphs";

export function SiteNav() {
  const pathname = usePathname();
  const [open, setOpen] = useState(false);
  const [hidden, setHidden] = useState(false);
  const { scrollY } = useScroll();
  const lenis = useLenis();
  const menuBtn = useRef<HTMLButtonElement>(null);

  useMotionValueEvent(scrollY, "change", (y) => {
    const prev = scrollY.getPrevious() ?? 0;
    setHidden(y > 240 && y > prev + 4);
    if (y < prev - 4) setHidden(false);
  });

  // close on route change
  useEffect(() => setOpen(false), [pathname]);

  useEffect(() => {
    if (open) lenis?.stop();
    else lenis?.start();
    document.documentElement.style.overflow = open ? "hidden" : "";
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        setOpen(false);
        menuBtn.current?.focus();
      }
    };
    if (open) window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [open, lenis]);

  return (
    <>
      <a href="#main" className="sr-only-focusable fixed left-4 top-4 z-[120] bg-green px-4 py-2 font-mono text-sm text-void">
        Skip to content
      </a>

      <motion.header
        initial={false}
        animate={{ y: hidden && !open ? "-130%" : "0%" }}
        transition={{ duration: 0.5, ease: [0.16, 1, 0.3, 1] }}
        className="fixed inset-x-0 top-0 z-[100] pointer-events-none"
      >
        <div className="container-x flex items-start justify-between pt-3 md:pt-4">            href="/"
            aria-label={`${event.name} — home`}
            className="pointer-events-auto relative block bg-void px-3 py-2 [clip-path:polygon(0_0,100%_0,94%_100%,0_100%)] pr-6"
          >
            <Logo tone="dark" priority className="h-9 w-auto md:h-11" />
          </Link>

          <nav aria-label="Primary" className="pointer-events-auto hidden lg:block">
            <ul className="flex items-center bg-void/90 px-2 py-1.5 backdrop-blur-sm [clip-path:polygon(2%_0,100%_0,98%_100%,0_100%)]">
              {nav.map((item) => {
                const active = item.href === pathname;
                return (
                  <li key={item.href}>
                    <Link
                      href={item.href}
                      aria-current={active ? "page" : undefined}
                      className={cn(
                        "group relative flex items-baseline gap-1.5 px-4 py-2 font-mono text-[0.78rem] uppercase tracking-[0.14em] transition-colors",
                        active ? "text-void" : "text-white/75 hover:text-white",
                      )}
                    >
                      {active ? (
                        <motion.span
                          layoutId="nav-active"
                          className="absolute inset-0 -z-0 bg-green [clip-path:polygon(4%_10%,100%_0,96%_92%,0_100%)]"
                          transition={{ type: "spring", stiffness: 380, damping: 32 }}
                        />
                      ) : null}
                      <span className={cn("relative text-[0.62rem]", active ? "text-void/70" : "text-green")}>{item.index}</span>
                      <span className="relative">{item.label}</span>
                    </Link>
                  </li>
                );
              })}
            </ul>
          </nav>

          <div className="pointer-events-auto flex items-center gap-3">

            <button
              ref={menuBtn}
              type="button"
              onClick={() => setOpen((o) => !o)}
              aria-expanded={open}
              aria-controls="site-menu"
              className="relative grid size-12 place-items-center bg-green text-void [clip-path:polygon(8%_0,100%_6%,92%_100%,0_94%)] lg:hidden"
            >
              <span className="sr-only">{open ? "Close menu" : "Open menu"}</span>
              <span aria-hidden="true" className="relative block h-3 w-6">
                <span className={cn("absolute left-0 top-0 h-[3px] w-6 bg-void transition-transform duration-300", open && "translate-y-[5px] rotate-45")} />
                <span className={cn("absolute bottom-0 left-0 h-[3px] w-4 bg-void transition-all duration-300", open && "w-6 -translate-y-[4px] -rotate-45")} />
              </span>
            </button>
          </div>
        </div>
      </motion.header>

      <AnimatePresence>
        {open ? (
          <motion.div
            id="site-menu"
            role="dialog"
            aria-modal="true"
            aria-label="Site menu"
            initial={{ clipPath: "polygon(0 0, 100% 0, 100% 0, 0 0)" }}
            animate={{ clipPath: "polygon(0 0, 100% 0, 100% 100%, 0 100%)" }}
            exit={{ clipPath: "polygon(0 100%, 100% 100%, 100% 100%, 0 100%)" }}
            transition={{ duration: 0.7, ease: [0.76, 0, 0.24, 1] }}
            className="fixed inset-0 z-[95] flex flex-col bg-void pt-24 dot-field-dark"
          >
            <nav aria-label="Mobile" className="container-x flex-1">
              <ul className="flex flex-col gap-1">
                {nav.map((item, i) => {
                  const active = item.href === pathname;
                  return (
                    <motion.li
                      key={item.href}
                      initial={{ y: 60, opacity: 0, rotate: 4 }}
                      animate={{ y: 0, opacity: 1, rotate: 0 }}
                      transition={{ delay: 0.25 + i * 0.06, duration: 0.7, ease: [0.16, 1, 0.3, 1] }}
                      style={{ paddingLeft: `${[0, 14, 4, 22, 8][i]}%` }}
                    >
                      <Link
                        href={item.href}
                        aria-current={active ? "page" : undefined}
                        className={cn(
                          "group flex items-start gap-3 font-display text-[clamp(3rem,15vw,6rem)] font-extrabold leading-[0.95] tracking-[-0.04em]",
                          active ? "text-green" : "text-white",
                        )}
                      >
                        <span className="mt-3 font-mono text-xs font-normal tracking-widest text-green">{item.index}</span>
                        {item.label}
                      </Link>
                    </motion.li>
                  );
                })}
              </ul>
            </nav>
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              transition={{ delay: 0.6 }}
              className="container-x flex flex-col gap-5 border-t border-white/10 py-6"
            >
              <TicketButton source="mobile-menu" />
              <div className="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs uppercase tracking-widest text-white/60">
                <Spark className="size-3 text-green" />
                <span>{event.dates}</span>
                <a href={`mailto:${organiser.email}`} className="text-white/80 underline-offset-4 hover:underline">
                  {organiser.email}
                </a>
              </div>
            </motion.div>
          </motion.div>
        ) : null}
      </AnimatePresence>
    </>
  );
}
