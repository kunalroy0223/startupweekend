# ─── Site ────────────────────────────────────────────────────────────────
# Canonical origin used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://startupweekend.sbs

# ─── Contact form (Resend) ───────────────────────────────────────────────
# Server-only. Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Sender address on a domain you have verified in Resend.
CONTACT_FROM_EMAIL="Startup Weekend Siliguri <website@startupweekend.sbs>"
# Where enquiries are delivered.
CONTACT_TO_EMAIL=contact@startupweekend.sbs

# ─── Optional: search & analytics ────────────────────────────────────────
# Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GSC_VERIFICATION=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave blank to disable.
NEXT_PUBLIC_GA_ID=
